{
  "name": "govspend-nexus-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Government Spend Audit & Procurement Intelligence System",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd services/backend-api && poetry run uvicorn main:app --port 8008 --reload",
    "dev:frontend": "cd govspend-frontend && npm run dev",
    "build": "npm run build:services && npm run build:frontend",
    "build:services": "poetry build",
    "build:frontend": "cd govspend-frontend && npm run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "poetry run pytest",
    "test:frontend": "cd govspend-frontend && npm run test",
    "test:coverage": "poetry run pytest --cov=services --cov-report=html",
    "lint": "poetry run ruff check .",
    "lint:frontend": "cd govspend-frontend && npm run lint",
    "format": "poetry run black .",
    "format:frontend": "cd govspend-frontend && npm run format",
    "clean": "rm -rf **/__pycache__ **/.pytest_cache **/.coverage dist build"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "prettier": "^3.0.0",
    "turbo": "^1.10.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
