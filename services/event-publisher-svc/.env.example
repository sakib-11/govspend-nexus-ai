# Event Publisher Service Configuration
EVENT_SERVICE_NAME=event-publisher-svc
EVENT_PORT=8006
EVENT_DEBUG=false

# Database Configuration
EVENT_DB_HOST=localhost
EVENT_DB_PORT=5432
EVENT_DB_NAME=govspend
EVENT_DB_USER=events_user
EVENT_DB_PASSWORD=events_pass

# Redis Configuration
EVENT_REDIS_HOST=localhost
EVENT_REDIS_PORT=6379
EVENT_REDIS_DB=0

# Stream Configuration
EVENT_INPUT_STREAM=bundle.events
EVENT_OUTPUT_STREAM=risk.events
EVENT_PRIORITY_STREAM=risk.priority
EVENT_ERROR_STREAM=event.errors
EVENT_CONSUMER_GROUP=event-publisher-group
EVENT_CONSUMER_NAME=event-publisher-1

# Priority Queue Configuration
EVENT_PRIORITY_QUEUE_KEY=risk_priority_queue
EVENT_CRITICAL_QUEUE=critical_tasks
EVENT_HIGH_QUEUE=high_priority_tasks
EVENT_MEDIUM_QUEUE=medium_priority_tasks
EVENT_LOW_QUEUE=low_priority_tasks

# Alert Configuration
EVENT_ALERT_THRESHOLD_HIGH=0.75
EVENT_ALERT_THRESHOLD_BORDERLINE=0.40
EVENT_ALERT_COOLDOWN_MINUTES=30

# Notification Channels
EVENT_SLACK_ENABLED=false
EVENT_SLACK_WEBHOOK_URL=
EVENT_EMAIL_ENABLED=false
EVENT_EMAIL_SMTP_HOST=
EVENT_EMAIL_SMTP_PORT=587
EVENT_EMAIL_SENDER=
EVENT_WEBHOOK_ENABLED=false
EVENT_WEBHOOK_ENDPOINTS=

# Kafka Configuration (optional)
EVENT_KAFKA_ENABLED=false
EVENT_KAFKA_BOOTSTRAP_SERVERS=
EVENT_KAFKA_TOPIC_RISK_EVENTS=govspend.risk.events
EVENT_KAFKA_TOPIC_CASES=govspend.cases

# Performance Configuration
EVENT_BATCH_SIZE=50
EVENT_PUBLISH_TIMEOUT_SECONDS=10
EVENT_WORKER_COUNT=5