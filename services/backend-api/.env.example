# Backend API service configuration
# All variables are consumed via pydantic-settings with the BACKEND_API_ prefix.
# Copy this file to .env (or provide values through your orchestrator/secrets manager).

# Service identity
BACKEND_API_SERVICE_NAME=backend-api

# Network binding
BACKEND_API_HOST=0.0.0.0
BACKEND_API_PORT=8008

# Runtime behavior
BACKEND_API_DEBUG=false
BACKEND_API_ENVIRONMENT=development
BACKEND_API_SEED_DEMO_DATA=true
BACKEND_API_LOG_LEVEL=INFO

# CORS and ingress
BACKEND_API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
BACKEND_API_ALLOWED_HOSTS=*
BACKEND_API_BEHIND_PROXY=false

# Data layer
DATABASE_URL=postgresql+psycopg2://govspend:govspend@postgres:5432/govspend
REDIS_URL=redis://redis:6379/0
