# ============================================
# GovSpend Nexus AI - Explanation Validator Service (Production)
# ============================================

# ---------- Service ----------
VALIDATOR_SERVICE_NAME=explanation-validator-svc
VALIDATOR_PORT=8018
VALIDATOR_HOST=0.0.0.0
VALIDATOR_DEBUG=false
VALIDATOR_LOG_LEVEL=WARNING
VALIDATOR_ENVIRONMENT=production

# ---------- Database ----------
VALIDATOR_DB_HOST=${DB_HOST:-postgres}
VALIDATOR_DB_PORT=${DB_PORT:-5432}
VALIDATOR_DB_NAME=govspend
VALIDATOR_DB_USER=govspend
VALIDATOR_DB_PASSWORD=${DB_PASSWORD}
VALIDATOR_DB_POOL_SIZE=20
VALIDATOR_DB_MAX_OVERFLOW=40
VALIDATOR_DB_SSL=true

# ---------- Redis ----------
VALIDATOR_REDIS_HOST=${REDIS_HOST:-redis}
VALIDATOR_REDIS_PORT=${REDIS_PORT:-6379}
VALIDATOR_REDIS_DB=0
VALIDATOR_REDIS_PASSWORD=${REDIS_PASSWORD}
VALIDATOR_REDIS_MAX_CONNECTIONS=20
VALIDATOR_CACHE_TTL_SECONDS=3600
VALIDATOR_CACHE_ENABLED=true

# ---------- LLM / AI Configuration ----------
VALIDATOR_GROQ_API_KEY=${GROQ_API_KEY}
VALIDATOR_OPENAI_API_KEY=${OPENAI_API_KEY}
VALIDATOR_LLM_MODEL=mixtral-8x7b-32768
VALIDATOR_LLM_TEMPERATURE=0.3
VALIDATOR_LLM_MAX_TOKENS=2048
VALIDATOR_REPHRASER_ENABLED=true
VALIDATOR_REPHRASER_MODEL=mixtral-8x7b-32768
VALIDATOR_REPHRASER_MAX_ATTEMPTS=2

# ---------- Validation Settings ----------
VALIDATOR_REQUIRE_100_PERCENT_GROUNDING=true
VALIDATOR_STRICT_CITATION_CHECK=true
VALIDATOR_VALIDATE_SCHEMA=true
VALIDATOR_VALIDATE_EVIDENCE_IDS=true
VALIDATOR_VALIDATE_POLICY_IDS=true
VALIDATOR_VALIDATE_DETECTOR_NAMES=true
VALIDATOR_MIN_GROUNDING_SCORE=1.0
VALIDATOR_ALLOWED_MISSING_CITATIONS=0
VALIDATOR_MAX_UNGROUNDED_SENTENCES=0

# ---------- Masking Settings ----------
VALIDATOR_MASK_UNGROUNDED_CLAIMS=true
VALIDATOR_MASK_MARKER=[UNCITED]
VALIDATOR_REPHRASE_UNGROUNDED=true

# ---------- Security ----------
VALIDATOR_JWT_SECRET=${JWT_SECRET}
VALIDATOR_HMAC_KEY=${LEDGER_ENC_KEY}
VALIDATOR_SECRET_KEY=${JWT_SECRET}
VALIDATOR_CORS_ORIGINS=["https://govspend.ai","https://app.govspend.ai"]

# ---------- Rate Limiting ----------
VALIDATOR_RATE_LIMIT_MAX_REQUESTS=200
VALIDATOR_RATE_LIMIT_WINDOW_SECONDS=60

# ---------- Monitoring ----------
VALIDATOR_ENABLE_METRICS=true
VALIDATOR_ENABLE_TRACING=true
VALIDATOR_LOG_FORMAT=json
VALIDATOR_METRICS_PORT=9090