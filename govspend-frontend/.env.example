# GovSpend Nexus AI Frontend — example config (copy to .env.<mode> and edit)

# Base URL of the backend REST API (Vite exposes only VITE_-prefixed vars)
VITE_API_URL=https://api.govspend.ai

# OpenID Connect identity provider (Keycloak realm)
VITE_OIDC_AUTHORITY=https://auth.govspend.ai/realms/govspend
VITE_OIDC_CLIENT_ID=govspend-frontend

# OIDC redirect / post-logout targets (must match the provider client config)
VITE_OIDC_REDIRECT_URI=https://app.govspend.ai/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://app.govspend.ai

# WebSocket endpoint for real-time features
VITE_WEBSOCKET_URL=wss://api.govspend.ai/ws

# Fall back to mock data when the backend is unreachable
# MUST be false in production (do NOT leak mock/placeholder data)
VITE_ENABLE_MOCK_FALLBACK=false
