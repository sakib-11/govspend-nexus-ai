{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://govspend.auditcore.gov/schemas/signal.json",
  "title": "Detector Signal",
  "description": "Output from a deterministic detector",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["price_deviation", "duplicate_fuzzy", "vendor_graph_risk", "timing_anomaly", "contract_splitting", "approval_velocity"],
      "description": "Detector type"
    },
    "value": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Signal strength (0 = no risk, 1 = maximum risk)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence in the signal"
    },
    "evidence_ref": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "References to evidence records"
    },
    "metadata": {
      "type": "object",
      "description": "Additional detector-specific metadata"
    }
  },
  "required": ["type", "value", "confidence"],
  "additionalProperties": false
}
