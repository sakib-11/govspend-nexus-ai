# ============================================
# GovSpend Nexus AI - Environment Variables
# ============================================

# ---------- Application ----------
APP_NAME=GovSpend Nexus AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
APP_VERSION=1.0.0
SECRET_KEY=YOUR_SECRET_KEY-1234567890

# ---------- Database ----------
DATABASE_URL=postgresql://govspend:govspend123@localhost:5432/govspend
DATABASE_TEST_URL=postgresql://govspend:govspend123@localhost:5433/govspend_test
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
REDIS_TEST_URL=redis://localhost:6380/0
REDIS_MAX_CONNECTIONS=10
CACHE_TTL_SECONDS=3600

# ---------- Security ----------
HMAC_KEY=YOUR_HMAC_KEY-abcdefghijklmnop
KMS_KEY_ID=YOUR_KMS_KEY_ID
JWT_SECRET=YOUR_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
MFA_ENABLED=false

# ---------- LLM / AI ----------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
EXPLANATION_GROQ_API_KEY=YOUR_GROQ_API_KEY
LLM_MODEL_HIGH=gpt-4o-mini
LLM_MODEL_MEDIUM=gpt-4o-mini
LLM_MODEL_LOW=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
RAG_TOP_K=3

# ---------- Thresholds ----------
HIGH_RISK_THRESHOLD=0.75
BORDERLINE_THRESHOLD=0.40
REVIEW_THRESHOLD=100000
MIN_PEER_SAMPLE=5
CONFIDENCE_SAMPLE_SIZE=10

# ---------- Detector Weights ----------
WEIGHT_PRICE_DEVIATION=0.30
WEIGHT_DUPLICATE_FUZZY=0.20
WEIGHT_VENDOR_GRAPH=0.20
WEIGHT_CONTRACT_SPLITTING=0.15
WEIGHT_TIMING_ANOMALY=0.10
WEIGHT_APPROVAL_VELOCITY=0.05

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=100
API_RATE_PERIOD=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Service Ports ----------
PORT_INGESTION=8001
PORT_DETECTION=8002
PORT_SCORING=8003
PORT_GATEWAY=8004
PORT_EXPLANATION=8005
PORT_MASKED_EVIDENCE=8006
PORT_LEDGER=8007
PORT_UNMASK=8008
PORT_AUDIT_LOG=8009
PORT_DIGITAL_TWIN=8010

# ---------- Docker ----------
DOCKER_REGISTRY=localhost:5000
DOCKER_NAMESPACE=govspend

# ---------- Testing ----------
TEST_TIMEOUT=30
TEST_RETRIES=3
TEST_COVERAGE_THRESHOLD=80
